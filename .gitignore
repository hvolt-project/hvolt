# Rust build output
target/

# Python build output
dist/
*.egg-info/

# Generated HarmonyOS projects (for testing)
# Anchored: an unanchored `build/` also matched `src/build/`, which is the compiler's own
# source tree — 63 `.rs` files that were never committed and could not be recovered.
/build/

# The same rule for the example projects: `examples/<name>/build/` is whichever tool ran
# there last (hvigor copies the whole project into it), never source.
/examples/*/build/

node_modules/
*.vsix

# npm packaging output (built by npm/stage.mjs, not source)
npm/prebuilt/
npm/platforms/*/bin/
*.tgz

# HarmonyOS build artifacts
.hvigor/
output/
oh_modules/
*.hap
.hvolt_manifest

# The private AppGallery Connect overlay arrives as a CI secret, never as source.
/agc-local/

# Local verification artifacts: flat project copies, signing-material copies, tarballs,
# and the local issue tracker. These hold plaintext keystore passwords and private keys —
# a blanket `git add -A` must never reach them.
.cache/
.scratch/

# One-off compile/capture artifacts land in the repo root by default; keep them out.
*.abc
# Except the golden byte-code a fixture compares against: that file is the baseline, not an
# artifact, and `abc_records` reads it by path. A fixture's `actual/` stays ignored.
!fixtures/*/golden/modules.abc
layout-*.json
screenshot-*.jpeg

# Local toolchain caches and virtualenvs (never committed).
.cargo-home/
.venv/

# Agent-side notes: this repository is public and these describe a local
# development setup, so they stay on the machine instead of in the tree.
/HANDOFF.md
/AGENTS.md
/docs/agents/
